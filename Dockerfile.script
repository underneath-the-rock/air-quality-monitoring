FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y cron && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY script.py config.py ./

RUN echo "*15 * * * * cd /app && python script.py >> /var/log/cron.log 2>&1" > /etc/cron.d/air-quality \
    && chmod 0644 /etc/cron.d/air-quality \
    && crontab /etc/cron.d/air-quality

CMD ["cron", "-f"]